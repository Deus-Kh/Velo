# Development (committed: it contains no secret). Loaded by react-native-dotenv when
# Metro runs in development mode (`npm start`, `npm run android`), on top of .env.
#
# `localhost` reaches the server on the computer that runs Metro through
# `adb reverse tcp:9999 tcp:9999` (run `npm run dev:reverse` once per connected
# device or emulator; `react-native run-android` does the same for Metro's 8081).
# It works the same for the Android emulator and for a phone on USB.
#
# A phone on Wi-Fi only: create .env.development.local (gitignored) with the
# computer's LAN address, e.g. API_URL=http://192.168.1.20:9999, and add that
# address to android/app/src/debug/res/xml/network_security_config.xml.
API_URL=http://localhost:9999
SOCKET_URL=http://localhost:9999
