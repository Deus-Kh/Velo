# Copy to .env. Never commit .env.
# Both URLs MUST be https:// in release builds (enforced at startup in src/shared/config/env.ts).
# Socket.IO upgrades https:// to wss:// automatically — do not write wss:// here.
# After editing .env run:  npm start -- --reset-cache
API_URL=https://api.velo.example.com
SOCKET_URL=https://api.velo.example.com
