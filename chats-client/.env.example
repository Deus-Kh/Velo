# Schema for react-native-dotenv (`safe: true`): every key listed here must be
# present in the environment that is loaded, or the build fails.
#
# Two environments, selected by Metro's mode:
#   development  ->  .env.development   (committed; localhost through `adb reverse`)
#   production   ->  .env.production    (gitignored; copy from .env.production.example)
#   test (Jest)  ->  .env.test          (committed)
# An optional .env is read first as a base and .env.<mode>.local last as a
# personal override (both gitignored). After changing any of them restart Metro:
#   npm start -- --reset-cache
API_URL=https://api.velo.example.com
SOCKET_URL=https://api.velo.example.com
