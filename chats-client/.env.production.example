# Production. Copy to .env.production (gitignored) and put the real API host in.
# Loaded by react-native-dotenv when Metro builds in production mode (a release
# build, or `react-native bundle --dev false`). Both URLs MUST be https:// —
# release builds refuse anything else (src/shared/config/env.ts), and the
# release network policy pins the host (android/app/src/main/res/xml/
# network_security_config.xml: the <domain> there must match this host).
# Socket.IO upgrades https:// to wss:// itself — do not write wss:// here.
API_URL=https://api.velo.example.com
SOCKET_URL=https://api.velo.example.com
