# Local development. Copy to .env.development (gitignored); `npm run dev` loads it.
# Everything stays on this machine: a local MongoDB, in-memory rate limits and
# presence (no Redis), the local blob store, no push unless the Firebase file exists.
NODE_ENV=development
PORT=9999
LOG_LEVEL=debug

# Local MongoDB (Windows service / brew / apt). A separate database name keeps dev data apart.
MONGO_URI=mongodb://127.0.0.1:27017/velo-dev

# Any random string of 32+ chars. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME_generate_with_the_node_one_liner_above
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=10

# Empty = in-memory limiter, presence and socket adapter (single process; fine locally).
REDIS_URL=

# Optional: push notifications. Leave the path pointing at a missing file to disable push.
FIREBASE_SERVICE_ACCOUNT_PATH=../../velo-secrets/firebase-admin.json

# Password breach lookup calls an external API; off locally so registration works offline.
PASSWORD_BREACH_CHECK=false

# Native clients send no Origin; leave empty.
CORS_ORIGINS=
METRICS_TOKEN=

# Attachments (T8.2): local files, URLs relative to the API base the client uses.
ATTACHMENT_TTL_DAYS=30
BLOB_DIR=./data/blobs
PUBLIC_BASE_URL=
