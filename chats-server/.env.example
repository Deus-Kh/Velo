# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=9999

# MongoDB connection string. Local dev example; use an Atlas URI in production.
MONGO_URI=mongodb://127.0.0.1:27017/velo

# At least 32 characters. Generate with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# Access-token lifetime (jsonwebtoken duration string). Refresh tokens extend sessions.
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL_DAYS=30

BCRYPT_ROUNDS=12

# Backs rate limits and login backoff. Required in production. Leave empty in
# development to use in-memory limits (single process, reset on restart).
REDIS_URL=redis://127.0.0.1:6379

# Firebase Admin service-account JSON. Keep it OUTSIDE the repository, e.g. ../secrets/.
FIREBASE_SERVICE_ACCOUNT_PATH=../secrets/firebase-admin.json

# Comma-separated browser origins allowed by CORS. Leave empty for native clients only.
CORS_ORIGINS=
