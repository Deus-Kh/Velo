# ============================================================================
# Two environments. The server loads, in this order of preference:
#   DOTENV_CONFIG_PATH (explicit)  >  .env.<NODE_ENV>  >  .env
# so `npm run dev` (NODE_ENV unset -> development) reads .env.development and a
# production process (NODE_ENV=production) reads .env.production, or, under
# systemd, /etc/velo/server.env via EnvironmentFile (deploy/README.md), which a
# file never overrides.
#
#   .env.development.example  ->  copy to .env.development  (local MongoDB, no Redis)
#   .env.example (this file)  ->  copy to .env.production / /etc/velo/server.env
# Both real files are gitignored. Never commit either.
# ============================================================================
# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=9999

# MongoDB connection string. Local dev example; use an Atlas URI in production.
MONGO_URI=mongodb://127.0.0.1:27017/velo

# At least 32 characters. Generate with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# Access-token lifetime (jsonwebtoken duration string). Refresh tokens extend sessions.
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL_DAYS=30

BCRYPT_ROUNDS=12

# Log level for the structured (pino) logs: trace|debug|info|warn|error|fatal.
LOG_LEVEL=info

# Bearer token Prometheus presents to GET /metrics (T4.6). Leave empty to disable the endpoint.
# Generate with:  openssl rand -hex 32
METRICS_TOKEN=

# Check new passwords against HaveIBeenPwned (k-anonymity range API; fails open). "false" to disable.
PASSWORD_BREACH_CHECK=true

# Backs rate limits and login backoff. Required in production. Leave empty in
# development to use in-memory limits (single process, reset on restart).
REDIS_URL=redis://127.0.0.1:6379

# Firebase Admin service-account JSON. Keep it OUTSIDE the repository tree (the path below is a sibling folder of the repo).
FIREBASE_SERVICE_ACCOUNT_PATH=../../velo-secrets/firebase-admin.json

# Comma-separated browser origins allowed by CORS. Leave empty for native clients only.
CORS_ORIGINS=

# T8.2: attachments (ciphertext blobs). Local files by default; set the S3_* variables to use an
# S3-compatible bucket (AWS, MinIO, R2) with presigned URLs instead. PUBLIC_BASE_URL is the
# origin clients reach the server on, used in the upload/download URLs of the local store
# ('' = relative URLs, resolved by the client against its API base).
ATTACHMENT_TTL_DAYS=30
BLOB_DIR=./data/blobs
PUBLIC_BASE_URL=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=true
